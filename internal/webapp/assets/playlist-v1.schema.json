{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://qobuz-curator.local/schemas/playlist-v1.schema.json","title":"Qobuz Curator Playlist Recommendation","description":"A service-neutral playlist recommendation that Qobuz Curator can match against the Qobuz catalog.","type":"object","additionalProperties":false,"required":["schema_version","name","tracks"],"properties":{"schema_version":{"const":"1.0"},"name":{"type":"string","minLength":1,"maxLength":250},"description":{"type":"string","maxLength":2000,"default":""},"source_prompt":{"type":["string","null"],"maxLength":10000,"default":null},"tracks":{"type":"array","minItems":1,"maxItems":200,"items":{"$ref":"#/$defs/track"}}},"$defs":{"track":{"type":"object","additionalProperties":false,"required":["position","title","artists"],"properties":{"position":{"type":"integer","minimum":1},"title":{"type":"string","minLength":1,"maxLength":500},"artists":{"type":"array","minItems":1,"maxItems":20,"items":{"type":"string","minLength":1,"maxLength":500}},"album":{"type":["string","null"],"maxLength":500,"default":null},"release_year":{"type":["integer","null"],"minimum":1900,"maximum":2200,"default":null},"duration_seconds":{"type":["integer","null"],"minimum":1,"maximum":7200,"default":null},"isrc":{"type":["string","null"],"minLength":5,"maxLength":32,"default":null},"version_hints":{"type":"array","maxItems":20,"items":{"type":"string","maxLength":200},"default":[]}}}}}
